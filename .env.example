# Copy to `.env` and fill in. `.env` is gitignored.

# Base URL of the tournament-bot HTTP API, no trailing slash.
# REQUIRED — `src/lib/api/http.ts` throws at startup without it rather than
# falling back to a hostname, so a deploy that forgets this fails loudly
# instead of quietly talking to the wrong backend.
# In CI and on deploy this comes from the VITE_API_BASE_URL repository variable.
VITE_API_BASE_URL=https://api.example.com

# Optional. Comma-separated conf ids to treat as the current league, e.g. "4" or
# "wed,thu". Takes precedence over the `active` flag on /tournaments.
# Leave empty to derive the season from the API.
VITE_ACTIVE_CONFS=
