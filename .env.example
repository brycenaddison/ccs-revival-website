# Copy to `.env` and fill in. `.env` is gitignored.

# Base URL of the tournament-bot HTTP API, no trailing slash.
# REQUIRED — `src/lib/api/http.ts` throws at startup without it rather than
# falling back to a hostname, so a deploy that forgets this fails loudly
# instead of quietly talking to the wrong backend.
# In CI and on deploy this comes from the VITE_API_BASE_URL repository variable.
VITE_API_BASE_URL=https://api.example.com

# Canonical production HTTPS origin, shared by client metadata, the shell and sitemap.
# Never set this to a local/preview hostname. Defaults to this CCS origin when omitted.
VITE_SITE_ORIGIN=https://www.ccsesports.org

# Optional. Invite URL for the CCS Discord, e.g. "https://discord.gg/ccslol".
# The team application form, the invitation inbox and the member-invite panel all
# offer it; leave it empty and each of them drops the link rather than rendering a
# dead one. Not secret — it ends up in the client bundle like every VITE_ value.
VITE_DISCORD_INVITE=
